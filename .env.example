# Agent Logger — Environment Configuration
# Copy this to .env and fill in the values below.
#
#   cp .env.example .env

# ── Discord Bot ──────────────────────────────────────────────────────
# Register a bot at https://discord.com/developers/applications
# Enable the "bot" scope with "applications.commands" and "Send Messages".
# Invite it to your server, then put its token here.

AGENT_LOGGER_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Only these Discord user IDs may use /sessions, /status, /changes.
# Get your user ID by enabling Developer Mode in Discord, then right-click
# your name → "Copy User ID".
# Format: comma-separated, e.g. "123456789,987654321"
# NOTE: if left empty (or unset), ALL commands are denied (fail closed).
AGENT_LOGGER_ALLOWED_USER_IDS=""

# Escape hatch: set to 1 to allow any user when the list above is empty.
# AGENT_LOGGER_ALLOW_ANY_USER="0"

# ── Session Tracking ─────────────────────────────────────────────────
# Path where the session SQLite database is stored.
# Default: ./sessions.db relative to the working directory.
AGENT_LOGGER_DB_PATH="sessions.db"

# ── Model Configuration ──────────────────────────────────────────────
# Open-weight model for generating session summaries.
# Supported values:
#   ollama:phi   — use Ollama (default server http://127.0.0.1:11434,
#                  override with OLLAMA_HOST). Requires `ollama pull phi`.
#   (empty)      — deterministic fallback only; works fully offline.
# AGENT_LOGGER_MODEL="ollama:phi"

# Optional: Ollama server URL
# OLLAMA_HOST="http://127.0.0.1:11434"

# Optional: path to a .gguf model for llama-cpp-python (if installed).
# AGENT_LOGGER_LLM_CPP_MODEL="/path/to/model.gguf"
# AGENT_LOGGER_N_GPU_LAYERS="0"

# ── Git Tracking ─────────────────────────────────────────────────────
# Default agent name used by `agent-logger start` when --agent is omitted.
# AGENT_LOGGER_AGENT_NAME="agent"

# ── General ──────────────────────────────────────────────────────────
# Prefix for legacy text commands (slash commands take precedence).
# AGENT_LOGGER_PREFIX="!"
